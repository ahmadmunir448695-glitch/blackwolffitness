{
  "name": "black-wolf-championship-api",
  "private": true,
  "version": "1.0.0",
  "description": "Championship management & online registration API for the Black Wolf website (Express + SQLite).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "migrate": "node --env-file-if-exists=.env src/migrate.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.17.2"
  }
}
