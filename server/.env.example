# ---------------------------------------------------------------------------
# Championship portal API — server environment variables.
# These are SECRETS / server settings. Never put them in the website's VITE_* vars.
# ---------------------------------------------------------------------------

# Required in production: long random string used to sign sign-in tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

NODE_ENV=production
PORT=8787

# Website origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=https://blackwolffitnessclub.netlify.app

# Public URL of the website (used in notifications).
PORTAL_URL=https://blackwolffitnessclub.netlify.app

# SQLite database file and upload folder. Put both on a persistent disk.
DATABASE_PATH=/var/data/championship.db
STORAGE_DIR=/var/data

# First super admin, created on start if no super admin exists yet.
# Remove ADMIN_PASSWORD from the host after the first start and change it in the portal.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin

# Max upload size per file (MB).
MAX_UPLOAD_MB=5

# Set to 1 when running behind a proxy/load balancer (Render, Railway, nginx),
# so rate limiting and audit logs see the real client IP.
TRUST_PROXY=1

# Session length in hours (default 7 days).
SESSION_TTL_HOURS=168
