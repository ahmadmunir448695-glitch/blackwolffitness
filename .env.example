# ---------------------------------------------------------------------------
# Black Wolf Fitness Club — frontend environment variables
# Copy this file to `.env` (or `.env.production`) and fill in what you need.
# Every VITE_* value is bundled into public JavaScript. NEVER put secrets here.
# ---------------------------------------------------------------------------

# Base URL of your existing API, e.g. https://api.blackwolf.example/api
# Leave empty to run the site on the local mock data in src/data/mock/.
# While this is empty, contact and trial forms validate input but cannot send.
VITE_API_BASE_URL=

# Optional: switch resources to the API one at a time while you migrate.
# Comma-separated list of: programs,coaches,memberships,schedule,contact
# Empty = every resource uses the API once VITE_API_BASE_URL is set.
VITE_API_RESOURCES=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=12000

# Optional artificial delay (ms) for mock data, useful to preview loading states.
VITE_MOCK_DELAY_MS=0

# Public URL of the deployed site, without a trailing slash.
# Used for canonical links, Open Graph URLs and sitemap.xml.
VITE_SITE_URL=
